# Copy this file to .env for local development, or set these as real
# environment variables in your deployment platform. Never commit .env.

# SQLAlchemy-style connection string. Defaults to a local SQLite file if
# unset; set to a Postgres URL in production -- no code changes required.
DATABASE_URL=

# Required -- the app fails to start without this (no code-level fallback,
# deliberately). Generate a random secret per deployment; never reuse the
# same value across environments or commit a real one here.
JWT_SECRET_KEY=

# Optional. The app uses HS256 / 1440 (24h) if these are left unset.
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=

# "development" (default) or "production". Controls whether the auth
# cookie is sent with the Secure flag, which requires HTTPS.
ENVIRONMENT=
